# Supabase public browser credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional compatibility if credentials were copied from a Vite project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public nurse registry source and scheduled index synchronization.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_NEW_NURSES_TABLE_ID=
AIRTABLE_NEW_NURSES_VIEW_ID=
AIRTABLE_OLD_NURSES_TABLE_ID=
AIRTABLE_OLD_NURSES_VIEW_ID=
REGISTRY_SYNC_SECRET=

# Public site URL used for draft resume links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Registration, renewal, indexing, and verification portal origin.
NEXT_PUBLIC_PORTAL_URL=http://127.0.0.1:3002

# Complaint portal settings.
NEXT_PUBLIC_COMPLAINTS_STORAGE_BUCKET=complaint-attachments
COMPLAINTS_DRAFT_EXPIRES_DAYS=30
COMPLAINTS_DRAFT_CLEANUP_GRACE_DAYS=7
COMPLAINTS_MAX_UPLOAD_MB=10
COMPLAINTS_MAX_UPLOAD_FILES=5

# Email delivery is not enabled yet. Keep these blank until a provider is selected.
COMPLAINTS_ADMIN_ALERT_EMAILS=
COMPLAINTS_SUPERVISOR_ALERT_EMAILS=
COMPLAINTS_FROM_EMAIL=
